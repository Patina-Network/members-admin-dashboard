AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Comma-separated Microsoft sign-in emails. Empty denies all access.
AZURE_ADMIN_EMAILS=
APP_ORIGIN=http://localhost:5173
# HS256 session signing key, at least 32 bytes: `openssl rand -base64 48`.
# Rotating it signs everyone out.
SESSION_SECRET=
# Optional lifetimes, e.g. `2h`, `90m`, `1h 30m`. Defaults: 2h and 10m.
SESSION_TTL=
LOGIN_TTL=
