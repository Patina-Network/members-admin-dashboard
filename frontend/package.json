{
  "name": "members-admin-dashboard-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run generate && vite",
    "build": "pnpm run generate && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm run generate && tsc -b --noEmit",
    "eslint": "eslint .",
    "stylelint": "stylelint '**/*.css'",
    "lint": "pnpm run eslint && pnpm run stylelint",
    "prettier": "prettier --check .",
    "vt": "vitest run --passWithNoTests",
    "test": "pnpm run typecheck && pnpm run prettier && pnpm run lint && pnpm run build && pnpm run vt",
    "generate": "node scripts/export-openapi.mjs && openapi-ts",
    "fix": "pnpm run eslint:fix && pnpm run stylelint:fix && pnpm run prettier:fix",
    "eslint:fix": "eslint . --fix",
    "stylelint:fix": "stylelint '**/*.css' --fix",
    "prettier:fix": "prettier --write ."
  },
  "dependencies": {
    "@mantine/core": "^8.1.2",
    "@mantine/dropzone": "^8.1.2",
    "@mantine/form": "^8.1.2",
    "@mantine/hooks": "^8.1.2",
    "@mantine/notifications": "^8.1.2",
    "@tabler/icons-react": "^3.30.0",
    "@tanstack/react-query": "^5.64.2",
    "motion": "^12.34.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.18.0",
    "use-immer": "^0.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-perfectionist": "^4.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.5.0",
    "stylelint": "^16.14.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.24.0"
}
